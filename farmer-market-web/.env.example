# FarmerMarket Frontend Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real values.

# Backend API base URL (used by Vite dev server proxy)
VITE_API_BASE_URL=http://localhost:5201

# App meta
VITE_APP_NAME=FarmerMarket
VITE_APP_VERSION=1.0.0

# NOTE: No payment credentials here — all payment secrets are server-side only.
# The backend manages Telebirr/Chapa/AfroMessage keys via appsettings or environment variables.
