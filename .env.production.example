# ==============================================================================
# Farmer-to-Market Exchange: Production Environment Configuration Template
# Copy this file to .env.production on your production server.
# NEVER commit .env.production with live credentials to Git.
# ==============================================================================

# ── General & Server ─────────────────────────────────────────────────────────
PORT=80
ASPNETCORE_ENVIRONMENT=Production
TZ=Africa/Addis_Ababa
CORS_ALLOWED_ORIGINS=https://farmermarket.et,https://www.farmermarket.et

# ── PostgreSQL & PostGIS Database ───────────────────────────────────────────
POSTGRES_DB=farmermarket
POSTGRES_USER=fm_prod_user
# Generate strong 32+ char password: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_DB_PASSWORD_32CHARS_MIN

# ── Redis In-Memory Cache ───────────────────────────────────────────────────
# Generate strong 32+ char password: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_REDIS_PASSWORD_32CHARS_MIN

# ── JWT Authentication (HMAC-SHA256) ─────────────────────────────────────────
# Minimum 64 characters long: openssl rand -base64 48
JWT_KEY=CHANGE_ME_TO_A_VERY_LONG_SECURE_JWT_SECRET_AT_LEAST_64_CHARS_LONG_2026!
JWT_ISSUER=https://farmermarket.et
JWT_AUDIENCE=https://farmermarket.et
JWT_EXPIRY_DAYS=30

# ── Chapa Payment Gateway (National Telebirr/CBE/Bank Escrow) ───────────────
CHAPA_SECRET_KEY=CHASECK_LIVE-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=CHAPUBK_LIVE-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_signature_secret
CHAPA_BASE_URL=https://api.chapa.co/v1

# ── Ethio Telecom Telebirr Escrow Gateway ────────────────────────────────────
TELEBIRR_APP_ID=your_telebirr_live_app_id
TELEBIRR_SHORT_CODE=your_telebirr_shortcode
TELEBIRR_APP_KEY=your_telebirr_live_app_key
TELEBIRR_BASE_URL=https://telebirr.et/pay

# ── SMS Gateway (AfroMessage / Ethio Telecom SMS) ───────────────────────────
SMS_PROVIDER=AfroMessage
AFROMESSAGE_API_KEY=your_live_afromessage_api_key
AFROMESSAGE_SENDER_ID=FarmerMkt

# ── SMTP Email Dispatch (Transactional notifications) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@farmermarket.et
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=noreply@farmermarket.et
SMTP_FROM_NAME="Farmer-to-Market Exchange"
