# ─── FarmerMarket Platform — Environment Variables Template ────────────────────
# Copy this to .env (git-ignored) and fill in real values.
# Backend secrets can alternatively be set via appsettings.Production.json
# or as system/container environment variables (Jwt__Key, Telebirr__AppId, etc.)

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
DB_PASSWORD=your_secure_db_password_here

# ─── JWT Authentication (32+ characters, cryptographically random) ─────────────
Jwt__Key=REPLACE_WITH_RANDOM_64_CHAR_STRING
Jwt__Issuer=FarmerMarket.API
Jwt__Audience=FarmerMarket.Client
Jwt__ExpiryDays=30

# ─── Payment: Telebirr ────────────────────────────────────────────────────────
Telebirr__AppId=YOUR_TELEBIRR_APP_ID
Telebirr__ShortCode=YOUR_TELEBIRR_SHORT_CODE
Telebirr__AppKey=YOUR_TELEBIRR_APP_KEY
Telebirr__BaseUrl=https://telebirr.et/pay
Telebirr__WebhookUrl=https://YOUR_DOMAIN/api/payments/telebirr/webhook
Telebirr__ReturnUrl=https://YOUR_DOMAIN/order-confirmation

# ─── Payment: Chapa (Ethiopian-native payment gateway) ────────────────────────
Chapa__SecretKey=CHASECK_YOUR_CHAPA_SECRET_KEY
Chapa__PublicKey=CHAPUBK_YOUR_CHAPA_PUBLIC_KEY
Chapa__WebhookSecret=YOUR_CHAPA_WEBHOOK_SECRET
Chapa__BaseUrl=https://api.chapa.co/v1
Chapa__WebhookUrl=https://YOUR_DOMAIN/api/payments/chapa/webhook
Chapa__ReturnUrl=https://YOUR_DOMAIN/order-confirmation

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
Email__Host=smtp.gmail.com
Email__Port=587
Email__EnableSsl=true
Email__Username=YOUR_EMAIL_OR_GMAIL_USERNAME
Email__Password=YOUR_GMAIL_APP_PASSWORD
Email__FromEmail=noreply@farmertomarket.et
Email__FromName=Farmer-to-Market Exchange

# ─── pgAdmin ──────────────────────────────────────────────────────────────────
PGADMIN_PASSWORD=your_secure_pgadmin_password_here

# ─── Active Payment Provider ─────────────────────────────────────────────────
Escrow__PaymentProvider=Chapa  # Options: Telebirr | Chapa

# ─── SMS Provider Selection ───────────────────────────────────────────────────
Sms__Provider=Log   # Options: Log | Twilio | AfroMessage

# ─── SMS: Twilio (limited Ethio Telecom support) ─────────────────────────────
Sms__Twilio__AccountSid=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
Sms__Twilio__AuthToken=YOUR_TWILIO_AUTH_TOKEN
Sms__Twilio__From=+251XXXXXXXXX

# ─── SMS: AfroMessage (Ethiopian-native, full Ethio Telecom support) ──────────
# Sign up at https://afromessage.com to get an API key
Sms__AfroMessage__ApiKey=YOUR_AFROMESSAGE_API_KEY
Sms__AfroMessage__From=FarmerMkt
