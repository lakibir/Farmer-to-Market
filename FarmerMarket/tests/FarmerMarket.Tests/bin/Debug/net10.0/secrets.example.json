{
  "_comment": "Copy this file to secrets.json and fill in your real values. Never commit secrets.json to source control.",
  "ConnectionStrings": {
    "Default": "Host=YOUR_DB_HOST;Port=5432;Database=farmermarket;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_RANDOM_64_CHAR_STRING_NEVER_COMMIT_THIS",
    "Issuer": "FarmerMarket.API",
    "Audience": "FarmerMarket.Client",
    "ExpiryDays": 30
  },
  "Telebirr": {
    "AppId": "YOUR_TELEBIRR_APP_ID",
    "ShortCode": "YOUR_TELEBIRR_SHORT_CODE",
    "AppKey": "YOUR_TELEBIRR_APP_KEY",
    "BaseUrl": "https://telebirr.et/pay",
    "WebhookUrl": "https://YOUR_DOMAIN/api/payments/telebirr/webhook",
    "ReturnUrl": "https://YOUR_DOMAIN/order-confirmation"
  },
  "Chapa": {
    "SecretKey": "CHASECK_YOUR_CHAPA_SECRET_KEY",
    "BaseUrl": "https://api.chapa.co/v1",
    "WebhookUrl": "https://YOUR_DOMAIN/api/payments/chapa/webhook",
    "ReturnUrl": "https://YOUR_DOMAIN/order-confirmation"
  },
  "Sms": {
    "Provider": "AfroMessage",
    "Twilio": {
      "AccountSid": "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "AuthToken": "YOUR_TWILIO_AUTH_TOKEN",
      "From": "+251XXXXXXXXX"
    },
    "AfroMessage": {
      "ApiKey": "YOUR_AFROMESSAGE_API_KEY",
      "From": "FarmerMkt",
      "BaseUrl": "https://api.afromessage.com/api/send"
    }
  },
  "Escrow": {
    "FarmerPercent": 90,
    "DriverPercent": 5,
    "PlatformPercent": 5,
    "PaymentProvider": "Telebirr"
  }
}
