# ==============================================================================
# Farmer-to-Market Exchange: Environment Configuration Template
# Copy this file to .env or .env.production and configure appropriate values.
# NEVER commit .env with real credentials into source control.
# ==============================================================================

# ── General Server Settings ──────────────────────────────────────────────────
PORT=80
ASPNETCORE_ENVIRONMENT=Production
TZ=Africa/Addis_Ababa
CORS_ALLOWED_ORIGINS=https://farmermarket.et,https://www.farmermarket.et
ENABLE_SWAGGER_IN_PRODUCTION=false
SEED_DEMO_DATA=false

# ── PostgreSQL with PostGIS Database ─────────────────────────────────────────
POSTGRES_DB=farmermarket
POSTGRES_USER=fm_prod_user
# Generate strong 32+ character password: openssl rand -base64 32
POSTGRES_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD_MIN_32_CHARS

# ── Redis 7 Cache & Rate Limiting ────────────────────────────────────────────
# Generate strong 32+ character password: openssl rand -base64 32
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD_MIN_32_CHARS

# ── JWT Authentication (HMAC SHA-256) ────────────────────────────────────────
# Must be at least 64 characters long: openssl rand -base64 48
JWT_KEY=YOUR_SECURE_JWT_SECRET_KEY_AT_LEAST_64_CHARS_LONG_FOR_PRODUCTION_2026!
JWT_ISSUER=https://farmermarket.et
JWT_AUDIENCE=https://farmermarket.et
JWT_EXPIRY_DAYS=30

# ── Business & Escrow Split Rules (Sum must equal 100) ──────────────────────
ESCROW_FARMER_PERCENT=90
ESCROW_DRIVER_PERCENT=5
ESCROW_PLATFORM_PERCENT=5
WITHHOLDING_TAX_PERCENT=2
VAT_ON_COMMISSION_PERCENT=15
HIGH_VALUE_PAYOUT_THRESHOLD_ETB=50000
DRIVER_SUBSIDY_ETB=150

# ── Payment Gateway Credentials (Chapa & Telebirr) ───────────────────────────
CHAPA_SECRET_KEY=CHASECK_LIVE-YOUR_CHAPA_SECRET_KEY
CHAPA_PUBLIC_KEY=CHAPUBK_LIVE-YOUR_CHAPA_PUBLIC_KEY
CHAPA_WEBHOOK_SECRET=YOUR_CHAPA_WEBHOOK_SECRET
CHAPA_BASE_URL=https://api.chapa.co/v1

TELEBIRR_APP_ID=YOUR_TELEBIRR_APP_ID
TELEBIRR_SHORT_CODE=YOUR_TELEBIRR_SHORTCODE
TELEBIRR_APP_KEY=YOUR_TELEBIRR_APP_KEY
TELEBIRR_BASE_URL=https://telebirr.et/pay

# ── SMS Provider Credentials (AfroMessage / Twilio) ──────────────────────────
SMS_PROVIDER=AfroMessage
AFROMESSAGE_API_KEY=YOUR_AFROMESSAGE_API_KEY
AFROMESSAGE_SENDER_ID=FarmerMkt

# ── Email Service (SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@farmermarket.et
SMTP_PASSWORD=YOUR_SMTP_APP_PASSWORD
SMTP_FROM_EMAIL=noreply@farmermarket.et
SMTP_FROM_NAME="Farmer-to-Market Exchange"

# ── Frontend Public API URL (for Vite client) ────────────────────────────────
VITE_API_BASE_URL=http://localhost:5155
